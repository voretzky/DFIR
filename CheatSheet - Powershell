===Useful Powershell Commands===

>General Commands
	Clear	or CTRL+L							clear screen
	Get-Verb								get a list of ps commands
	Get-Help
	Get-Help out-file							help on specific topic
	Stop-Process								kill the process
	Remove-Item [Path\Name]							remove folder\file [Path\Name]

>Output Formatting
	Format-Table
	Format-List
	Out-GridView								uses GUI to display output, includes filters
	Out-File								output to the file
	Convert-ToCsv | Out-File -File Path [C:\..]

>Processes Analysis
	Get-Process		                    				get info about running processes, 							alternative: wmic.exe process
    	Get-Process 'power*'           						get info about named process with wildcard
	Get-Process -Name powershell						get info about named process
	Get-Process -Id 1234							get info about process with PID 1234
    	Get-Process 'powershell' | Select-Object *    				get detailled (all objects) info about a named process
	Get-Process  Computer-Name STUDENT            			get info about running processes on a remote system
	Get-Process | Get-Member						lists all properties available for a command
	Get-Process | Select-Object -Property *					lists all properties of all processes
	Get-Process | Select-Object -Property Name,Id,Path			lists selected properties (Name, ID, Path) of all processes
	
	Get-Process | Select-Object -Property Path, Name, Id | Where-Object -Property Name -eq explorer
										lists selected properties (Name, ID, Path) of the processes which name is "explorer"

	Get-Process | Select-Object -Property Path, Name, Id | Where-Object -Property Path -Like "*temp*"
										lists selected properties (Name, ID, Path) of the processes which path contains "temp"

	Get-CimInstance -Class [or ClassName] Win32_Process			lists processes with the class tyme win32 process
	Get-CimInstance -Class Win32_Process | Select-Object -Property *	lists full details of all processes with the class tyme win32 process

	Get-CimInstance -Class Win32_Process | Select-Object -Property Name, Path, ProcessId, ParentProcessId	
										lists full selected details of all processes with the class tyme win32 process
	Get-CimInstance -Class Win32_Process | Where-Object -Property ParentProcessId -eq 123			
										lists full details of the process with Parent PID 123

>Services Analysis
	Get-Service								list all services configured								alternative: sc.exe query
	Get-Service | Select-Object -Property *					lists all properties of all services
	Get-CimInstance -ClassName Win32_Service | Select-Object *		lists all properties of all services
	Get-CimInstance -ClassName Win32_Service | Format-List Name, Description, PathName
										list all services with selected properties as a list
	Get-CimInstance -ClassName Win32_Service | Select-Object -Property Name, State, Description, PathName
										list all services with selected properties as a table
	sc.exe delete [Name]							remove service [Name]


>Network Analysis
	Get-NetTCPConnection		                    			get a list of network connections for this host						alternative: netstat.exe -nao
	Get-NetTCPConnection | Select-Object -Property LocalAddress, LocalPort, State, OwningProcess
										get a list of network connections with a selection of properties displayed:
											LocalAddress: 	The IP address that will accept connections for this listener or is used for the outbound connection [ 0.0.0.0 - IPv4, :: - IPv6 - all interfaces]
											LocalPort: 	The local port number used for the connection; if the state is Listen, then this is the listening TCP port number
											State: 		The state of the network connection
											OwningProcess: 	The process ID of the process that made the connection or is listening for connections


>Scheduled Tasks
	Get-ScheduledTask [TaskName] | Select-Object -Property TaskName													alternative: schtasks.exe		
	Export-ScheduledTask -TaskName [Name]
	Get-ScheduledTaskInfo -TaskName [Name] | Select-Object LastRunTime
	Unregister-ScheduledTask -TaskName "[Name]"					Remove scheduled task

>User Accounts
	Get-LocalUser								all local users										alternative: net.exe user
	Get-LocalGroup								all local groups									alternative: net.exe localgroup
	Get-LocalGroupMember [GroupName]					members of local group [GroupName]

	net.exe user								list all users
	net user /add [UserName] [Password]					create a username with [Username] and [Password]
	net local group administrators /add [Username]				add user [Username] to local administrators group

>Windows Log																				alternative: wevtutil.exe
	Get-WinEvent Filter-Hashtable @{LogName='Security';StartTime=01/12/2024;EndTime=02/12/2024;}			[Note]Define variable $start = Get-Date 01/12/2024 and replace the code: StartTime=$start, this is the FASTER method, {} specifies hashtable
															$start=Get-Date 01/12/2024;
															$end=Get-Date 02/12/2024;
															Get-WinEvent Filter-Hashtable @{LogName='Security';StartTime=$start;EndTime=$end;}

	Get-WinEvent -LogName system 
	Get-WinEvent -LogName system | Where-Object -Property id -eq 1234 | Format-List -Property TimeCreated,Message		[Note] this is the older - slower method. The whole log is imported
>IR Example
	Get-NetTCPConnection 								>	Get the list of running connections, notice a suspicious port open and related PID
	Get-Process -Id [PID]								>	Obtain details of the related process based on PID lookup
	Get-Process -Name [name] | Select-Object -Property Name,Id,Path			>	Obtain the location of the process
	Get-CimInstance -Class Win32_Process | Where-Object -Property Name -eq [Name]	
	or
	Get-CimInstance -Class Win32_Process | Where-Object -Property Id -eq [PID]	>	Get more details on the process [NOTE: name might be slighly differnt from the previous step - PS inconsistent with the naming]
	Get-CimInstance -Class Win32_Process | Where-Object -Property Id -eq [PID] | Select-Object -property Name, Path, ProcessParentId, CommandLine
											>	Obtain command line arguments for the process. 
	Get-Process | Select-Object -Property Path, Name, Id | Where-Object -Property Id -eq [PID] | Stop-Process
											>	kill suspicious process

>Differential Analysis - compare the current system against the baseline system												alternative: fc.exe
	Get-Service > baseline_services_2024-12-01.txt					get the list of services on the healty system, and save to a txt
	Get-Service > investigated-system_services_2024-12-01.txt			get the list of services on investigated system, and save to a txt
	$baseline=Get-Content .\baseline_services_2024-12-01.txt			set variable $baseline for baseline_services_2024-12-01.txt
	$current=Get-Content .\investigated-system_services_2024-12-01.txt		set variable $current for investigated-system_services_2024-12-01.txt
	Compare-Object -ReferenceObject $baseline -DifferenceObject $current		compare

	
